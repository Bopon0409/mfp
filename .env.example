# Self-host settings (docker compose): copy to .env and fill in.

# Service passwords (be sure to change them).
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=mfp
MINIO_ROOT_PASSWORD=change-me-too

# The address people open MFP at (used in email links); the port on the machine.
MFP_APP_URL=http://localhost:8080/
MFP_PORT=8080

# Sign-in: email — codes by email (needs SMTP below); password — username and password, accounts are
# created by the administrator (the first one — with the code from the log: docker compose logs mfp).
MFP_AUTH=email

# Closed network: off — editors of this server never go to the internet (AI, font catalog, updates).
MFP_NETWORK=on

# Email (sign-in codes, invitations). Empty — emails go to the container log (docker compose logs mfp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MFP <noreply@example.com>

# Enterprise (ee/): sign-in through the company SSO (OpenID Connect).
# Redirect URL at the provider: <MFP_PUBLIC_URL>/api/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Sign in with company SSO
# Company email domains (comma-separated): they use SSO only.
OIDC_DOMAINS=
# Public server address (when behind a proxy), for example https://mfp.example.com
MFP_PUBLIC_URL=
# SCIM 2.0 for the directory (Okta, Entra ID…): URL <MFP_PUBLIC_URL>/scim/v2, this token.
SCIM_TOKEN=
# Audit log: 1 — on (turns on by itself with SSO or SCIM).
MFP_AUDIT=
